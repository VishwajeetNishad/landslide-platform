# ============================================================
# .env.example  --  TEMPLATE hai, asli passwords ISME NAHI
#
# Use karne ka tareeka:
#     cp .env.example .env
# Phir .env mein asli values daalo.
#
# KYUN do file:
#   .env.example  -> GitHub par JAATI hai. Team ko pata chalta hai ki
#                    kaun-kaun se variables chahiye.
#   .env          -> GitHub par KABHI NAHI jaati (.gitignore mein hai).
#                    Isme asli password hote hain.
#
# Password ek baar push ho gaya toh Git history mein HAMESHA reh jaata hai --
# file baad mein delete karne par bhi. Isliye ye do-file pattern industry
# standard hai.
# ============================================================

# ---------- Database (V3 mein docker-compose isko use karega) ----------
POSTGRES_USER=landslide
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=landslide
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Node ka postgres driver isko poora URL ki tarah padhta hai.
# NOTE: prefix sirf "postgresql://" hai. Python ka "postgresql+psycopg2://"
# yahan kaam nahi karega -- woh SQLAlchemy ka apna format tha.
DATABASE_URL=postgresql://landslide:change_me_locally@localhost:5432/landslide

# ---------- App ----------
APP_ENV=development
# is_demo_data flag isse aata hai -- true hone par UI par orange banner dikhta hai
DEMO_MODE=true
LOG_LEVEL=info

# Backend kaunse port par sunega
PORT=8000
HOST=127.0.0.1

# ---------- Auth (V10 mein) ----------
# Asli secret aise banao:  python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change_me_generate_a_random_one
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---------- External data sources (baad ke steps) ----------
# [VERIFY] IMD API ka access terms confirm karna hai
IMD_API_KEY=
IMD_API_BASE_URL=

# NASA Earthdata (GPM IMERG rainfall, SMAP soil moisture) -- free registration
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Copernicus Data Space (Sentinel-1 SAR, Sentinel-2 optical) -- free registration
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# ---------- SMS gateway (V13) ----------
# Prototype mein SMS console par print hoga, asli gateway nahi lagega.
# SMS_PROVIDER=console  -> terminal par print
# SMS_PROVIDER=live     -> asli gateway (demo mein NAHI)
SMS_PROVIDER=console
SMS_SENDER_ID=
SMS_API_KEY=
