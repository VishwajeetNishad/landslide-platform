{
  "name": "landslide-platform-backend",
  "version": "0.2.0",
  "private": true,
  "description": "Backend API for the landslide early-warning and monitoring platform (NER pilot: Aizawl, Mizoram)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/server.js",
    "start": "node --env-file-if-exists=../.env src/server.js",
    "migrate": "node --env-file-if-exists=../.env src/db/migrate.js",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "^5.2.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "pino-pretty": "^13.0.0"
  }
}
